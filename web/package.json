{
  "name": "@memoryos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "pnpm --package=@hey-api/openapi-ts@0.99.0 --package=typescript@6.0.3 dlx openapi-ts",
    "check:api": "node scripts/assert-generated-stable.mjs src/lib/hey-api -- pnpm generate:api",
    "check:ci": "node scripts/assert-playwright-image.ts",
    "check:i18n": "node scripts/i18n-audit.mjs --check",
    "check:knip": "knip",
    "dev": "pnpm generate:api && vite",
    "dev:e2e": "pnpm generate:api && node scripts/start-e2e-server.ts",
    "mock-api": "node scripts/start-mock-api.ts",
    "typecheck": "tsc -b",
    "build": "vite build && node scripts/assert-font-assets.mjs && node scripts/assert-bundle-budget.mjs && tsc -b",
    "check:routes": "node scripts/assert-generated-stable.mjs src/routeTree.gen.ts src/lib/cn-tables.ts -- pnpm build",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:staging": "playwright test --config playwright.staging.config.ts --grep-invert @preflight",
    "test:staging:preflight": "playwright test --config playwright.staging.config.ts --grep @preflight",
    "preview": "vite preview",
    "check": "pnpm check:api && pnpm check:ci && pnpm check:i18n && pnpm check:knip && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm check:routes"
  },
