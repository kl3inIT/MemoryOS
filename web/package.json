{
  "name": "@memoryos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "pnpm dlx --package @hey-api/openapi-ts@0.99.0 --package typescript@6.0.3 openapi-ts",
    "check:api": "node scripts/assert-generated-stable.mjs src/lib/hey-api -- pnpm generate:api",
    "check:ci": "node scripts/assert-playwright-image.ts",
    "dev": "pnpm generate:api && vite",
    "dev:e2e": "pnpm generate:api && node scripts/start-e2e-server.ts",
    "typecheck": "tsc -b",
    "build": "vite build && node scripts/assert-font-assets.mjs && tsc -b",
    "check:routes": "node scripts/assert-generated-stable.mjs src/routeTree.gen.ts -- pnpm build",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "check": "pnpm check:api && pnpm check:ci && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm check:routes"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-table": "9.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.34",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
