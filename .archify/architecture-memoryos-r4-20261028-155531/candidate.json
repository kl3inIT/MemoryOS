  "cards": [
    {
      "dot": "emerald",
      "title": "Data authority",
      "items": [
        "PostgreSQL decides who may read what",
        "OpenSearch and Redis can be rebuilt and never grant access"
      ]
    },
    {
      "dot": "cyan",
      "title": "Background work",
      "items": [
        "Redis delivers each job at least once",
        "Workers reload the job from PostgreSQL before running it"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Keycloak signs users in; MemoryOS never stores passwords",
        "Sources are read only"
      ]
    }
