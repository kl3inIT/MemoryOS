# Names only; values come from Infisical or your shell. Never commit a value.
MEMORYOS_BASE_URL=https://memoryos.example
MEMORYOS_ISSUER=https://auth.example/realms/memoryos
# One label per actor; datasets/questions.jsonl refers to these labels.
MEMORYOS_BENCHMARK_ACTORS=exec,finance,legal,hr,governance,ir,outsider

# Preferred: `rag-benchmark login --actor <label>` signs each actor in through the browser
# (public client memoryos-integration, PKCE, loopback redirect http://127.0.0.1:8765/callback) and keeps
# its refresh token outside the repository, renewing the 5-minute access token during a run.
# MEMORYOS_BENCHMARK_TOKENS=~/.memoryos-rag-benchmark/tokens.json
# MEMORYOS_BENCHMARK_LOGIN_CLIENT=memoryos-integration
# MEMORYOS_BENCHMARK_LOGIN_PORT=8765

# Alternatives per actor (suffix = label in upper case, "-" as "_"): a service-account client bound to
# the actor, or a bearer token captured for one run shorter than its five-minute lifetime.
# MEMORYOS_BENCHMARK_CLIENT_EXEC=
# MEMORYOS_BENCHMARK_SECRET_EXEC=
# MEMORYOS_BENCHMARK_TOKEN_EXEC=

MEMORYOS_JUDGE_API_KEY=
MEMORYOS_JUDGE_MODEL=qwen/qwen3.8-27b
MEMORYOS_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# Empty sends no temperature: needed for reasoning judges such as OpenAI gpt-6-luna, which accept only the default.
MEMORYOS_JUDGE_TEMPERATURE=0
# Lượt chấm mỗi câu; điểm ghi lại là đa số, nên đặt số lẻ (hòa tính là sai). 1 để chạy nhanh.
MEMORYOS_JUDGE_TRIALS=3
