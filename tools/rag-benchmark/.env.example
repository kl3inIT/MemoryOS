# Names only; values come from Infisical or your shell. Never commit a value.
MEMORYOS_BASE_URL=https://memoryos.example
MEMORYOS_ISSUER=https://auth.example/realms/memoryos
MEMORYOS_BENCHMARK_ACTORS=authorized,unauthorized
# Each actor authenticates through its own service-account client (the realm enables no password grant),
# or through a bearer token captured for one run.
MEMORYOS_BENCHMARK_CLIENT_AUTHORIZED=
MEMORYOS_BENCHMARK_SECRET_AUTHORIZED=
MEMORYOS_BENCHMARK_CLIENT_UNAUTHORIZED=
MEMORYOS_BENCHMARK_SECRET_UNAUTHORIZED=
# MEMORYOS_BENCHMARK_TOKEN_AUTHORIZED=
# MEMORYOS_BENCHMARK_TOKEN_UNAUTHORIZED=
MEMORYOS_JUDGE_API_KEY=
MEMORYOS_JUDGE_MODEL=qwen/qwen3.8-27b
MEMORYOS_JUDGE_BASE_URL=https://openrouter.ai/api/v1
