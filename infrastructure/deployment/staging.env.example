# Values Compose cannot default: release images, passwords, public origins, the Tenant
# identity and secret-file locations. Every other setting (networks, volumes, loopback
# ports, UIDs, Redis pool, Docling limits, Mailpit retention) has its default in
# compose.base.yaml or compose.staging.yaml; add it here only to override that default.

# Release images; the remaining pinned images default in Compose.
MEMORYOS_API_IMAGE=
MEMORYOS_WORKER_IMAGE=
MEMORYOS_WEB_IMAGE=
MEMORYOS_INTERPRETER_IMAGE=
MEMORYOS_INTERPRETER_EXECUTOR_IMAGE=
MEMORYOS_KEYCLOAK_IMAGE=ghcr.io/kl3init/orgmemory-keycloak@sha256:fdd438632057fd3ec6c2a62578098c34a81dd66bfb2b892721a1b92f92a9cc5c
MEMORYOS_MAILPIT_IMAGE=axllent/mailpit:v1.31.0@sha256:c96991d9bef73594c246d89ca81411d4e916f03e76a7d2d72fa2ab5dd3c9ce24
MEMORYOS_OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.3@sha256:10a1165743a192e1940b4708fb9647027185ce11a681a1c5519b442ff7f1f561

# PostgreSQL platform administrator and MemoryOS application role passwords
MEMORYOS_POSTGRES_ADMIN_PASSWORD=
MEMORYOS_DATABASE_PASSWORD=

# Docling: Worker extraction options and private service limits default in compose.base.yaml.
# Keep the Worker timeout within the service document maximum; see docs/specs/ingestion.md
# and docs/runbooks/docling-extraction.md before overriding. MEMORYOS_EXTRACTION_DOCLING_API_KEY
# is an Infisical-managed Worker secret; never put its value here.

# Private object storage. Deployment-owned secret files are mounted into bootstrap
# and the matching API or worker runtime; no secret value belongs in this file.
MEMORYOS_MINIO_ROOT_PASSWORD_FILE=/apps/memoryos/secrets/minio/root-password.txt
MEMORYOS_MINIO_API_SECRET_KEY_FILE=/apps/memoryos/secrets/minio/api-secret-key.txt
MEMORYOS_MINIO_WORKER_SECRET_KEY_FILE=/apps/memoryos/secrets/minio/worker-secret-key.txt
MEMORYOS_OBJECT_STORAGE_UPLOAD_ENDPOINT=https://memoryos-objects.72-62-193-33.nip.io
MEMORYOS_OBJECT_STORAGE_BROWSER_ORIGIN=https://memoryos.72-62-193-33.nip.io
MEMORYOS_OBJECT_STORAGE_CONNECT_SRC=https://memoryos-objects.72-62-193-33.nip.io
MEMORYOS_MINIO_CONSOLE_PUBLIC_URL=https://memoryos-minio.72-62-193-33.nip.io
MEMORYOS_MINIO_CONSOLE_OIDC_CLIENT_SECRET_FILE=/apps/memoryos/secrets/inspection/minio-console-oidc-client-secret.txt

# Stable Tenant bootstrap contract
MEMORYOS_TENANT_ID=
MEMORYOS_TENANT_SLUG=
MEMORYOS_TENANT_DISPLAY_NAME=
MEMORYOS_INITIAL_TENANT_CHANGE_REFERENCE=

# TLS Redis. The worker's and API's host, port, ACL user and TLS mode are fixed in compose.staging.yaml;
# they read MEMORYOS_REDIS_WORKER_PASSWORD_FILE and MEMORYOS_REDIS_API_PASSWORD_FILE as their credentials. No password belongs here.
MEMORYOS_REDIS_ADMIN_PASSWORD_FILE=/apps/memoryos/secrets/redis/admin-password.txt
MEMORYOS_REDIS_WORKER_PASSWORD_FILE=/apps/memoryos/secrets/redis/worker-password.txt
MEMORYOS_REDIS_API_PASSWORD_FILE=/apps/memoryos/secrets/redis/api-password.txt
MEMORYOS_REDIS_INSPECTOR_PASSWORD_FILE=/apps/memoryos/secrets/redis/inspector-password.txt
MEMORYOS_REDIS_TLS_CA_FILE=/apps/memoryos/secrets/redis/ca.crt
MEMORYOS_REDIS_TLS_CERTIFICATE_FILE=/apps/memoryos/secrets/redis/server.crt
MEMORYOS_REDIS_TLS_PRIVATE_KEY_FILE=/apps/memoryos/secrets/redis/server.key

# Shared Keycloak database and runtime
MEMORYOS_KEYCLOAK_DATABASE_PASSWORD=
MEMORYOS_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
MEMORYOS_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
MEMORYOS_KEYCLOAK_HOSTNAME=https://auth.kl3in.tech
MEMORYOS_KEYCLOAK_LOG_LEVEL=INFO,org.keycloak.events:DEBUG,org.keycloak.services:DEBUG
MEMORYOS_KEYCLOAK_PROVISIONER_CLIENT_SECRET=

# Staging-only captured email. UID/GID must own the data directory.
MEMORYOS_MAILPIT_UID=1000
MEMORYOS_MAILPIT_GID=1000
MEMORYOS_MAILPIT_DATA_DIRECTORY=/apps/memoryos/mailpit
MEMORYOS_MAILPIT_PUBLIC_URL=https://memoryos-mail.72-62-193-33.nip.io
MEMORYOS_MAILPIT_SMTP_AUTH_FILE=/apps/memoryos/secrets/mailpit/smtp-auth.txt
MEMORYOS_MAILPIT_SMTP_CA_FILE=/apps/memoryos/secrets/mailpit/ca.crt
MEMORYOS_MAILPIT_SMTP_TLS_CERTIFICATE_FILE=/apps/memoryos/secrets/mailpit/smtp.crt
MEMORYOS_MAILPIT_SMTP_TLS_PRIVATE_KEY_FILE=/apps/memoryos/secrets/mailpit/smtp.key
MEMORYOS_MAILPIT_OAUTH2_ALLOWED_EMAILS_FILE=/apps/memoryos/secrets/mailpit/oauth2-allowed-emails.txt
MEMORYOS_MAILPIT_OAUTH2_CLIENT_SECRET_FILE=/apps/memoryos/secrets/mailpit/oauth2-client-secret.txt
MEMORYOS_MAILPIT_OAUTH2_COOKIE_SECRET_FILE=/apps/memoryos/secrets/mailpit/oauth2-cookie-secret.txt

# Staging-only PostgreSQL inspection
MEMORYOS_PGWEB_PUBLIC_URL=https://memoryos-db.72-62-193-33.nip.io
MEMORYOS_PGWEB_DATABASE_PASSWORD_FILE=/apps/memoryos/secrets/inspection/pgweb-database-password.txt
MEMORYOS_PGWEB_OAUTH2_CLIENT_SECRET_FILE=/apps/memoryos/secrets/inspection/pgweb-oauth2-client-secret.txt
MEMORYOS_PGWEB_OAUTH2_COOKIE_SECRET_FILE=/apps/memoryos/secrets/inspection/pgweb-oauth2-cookie-secret.txt

# Staging-only Redis inspection
MEMORYOS_REDISINSIGHT_ENCRYPTION_KEY_FILE=/apps/memoryos/secrets/inspection/redisinsight-encryption-key.txt
MEMORYOS_REDISINSIGHT_PUBLIC_URL=https://memoryos-redis.72-62-193-33.nip.io
MEMORYOS_REDISINSIGHT_OAUTH2_CLIENT_SECRET_FILE=/apps/memoryos/secrets/inspection/redisinsight-oauth2-client-secret.txt
MEMORYOS_REDISINSIGHT_OAUTH2_COOKIE_SECRET_FILE=/apps/memoryos/secrets/inspection/redisinsight-oauth2-cookie-secret.txt

# Mode-0600 Universal Auth bootstrap file outside Git. It contains only the
# Infisical domain/project/environment plus the staging identity client credentials.
MEMORYOS_INFISICAL_BOOTSTRAP_FILE=/apps/memoryos/secrets/api-infisical-auth.staging.env

# MEM-57: start the independent observability stack before application rollout.
MEMORYOS_RELEASE=

# MEM-58: browser-visible Sentry Cloud endpoint. This is not a credential; do not
# set a Sentry source-map upload token on the staging host. Replay defaults to enabled
# with text/input masking and media blocking.
MEMORYOS_SENTRY_DSN=
# Exact DSN origin only, for example https://o123.ingest.us.sentry.io.
MEMORYOS_SENTRY_CONNECT_SRC=
MEMORYOS_SENTRY_ENVIRONMENT=staging

# Search staging overlay: native TLS and Dashboards SSO. Service password,
# HTTPS endpoint and single-node replica count are managed in Infisical staging.
MEMORYOS_OPENSEARCH_SECRET_DIRECTORY=/apps/memoryos/secrets/opensearch
MEMORYOS_OPENSEARCH_OIDC_ISSUER=https://auth.kl3in.tech/realms/memoryos
MEMORYOS_OPENSEARCH_DASHBOARDS_PUBLIC_URL=https://memoryos-search.72-62-193-33.nip.io
