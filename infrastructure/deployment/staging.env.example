# Immutable runtime images
MEMORYOS_POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382
MEMORYOS_SHARED_KEYCLOAK_IMAGE=ghcr.io/kl3init/orgmemory-keycloak@sha256:fdd438632057fd3ec6c2a62578098c34a81dd66bfb2b892721a1b92f92a9cc5c
MEMORYOS_MAILPIT_IMAGE=axllent/mailpit:v1.31.0@sha256:c96991d9bef73594c246d89ca81411d4e916f03e76a7d2d72fa2ab5dd3c9ce24
MEMORYOS_OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.3@sha256:10a1165743a192e1940b4708fb9647027185ce11a681a1c5519b442ff7f1f561
MEMORYOS_REDIS_IMAGE=redis:8.2.1-alpine@sha256:987c376c727652f99625c7d205a1cba3cb2c53b92b0b62aade2bd48ee1593232
MEMORYOS_PGWEB_IMAGE=sosedoff/pgweb:0.17.0@sha256:a5256d416e2e8b92d69a4459058e3eca33a9f075d8325491644411d0bc3bd70b
MEMORYOS_REDISINSIGHT_IMAGE=redis/redisinsight:3.8.0@sha256:b5e19ee240abef6edb435871b90ff8a210995422e8e018ab61c0339d318a1f84
MEMORYOS_API_IMAGE=
MEMORYOS_WORKER_IMAGE=
MEMORYOS_WEB_IMAGE=

# PostgreSQL server bootstrap
MEMORYOS_POSTGRES_ADMIN_USER=memoryos_platform
MEMORYOS_POSTGRES_ADMIN_PASSWORD=
MEMORYOS_POSTGRES_HOST_PORT=5556
MEMORYOS_BACKUP_DIRECTORY=/apps/memoryos/backups
MEMORYOS_BACKUP_DATABASES=memoryos keycloak
MEMORYOS_BACKUP_UID=1000
MEMORYOS_BACKUP_GID=1000
MEMORYOS_POSTGRES_VOLUME=memoryos-postgres-data

# MemoryOS application database
MEMORYOS_DATABASE_NAME=memoryos
MEMORYOS_DATABASE_USERNAME=memoryos_app
MEMORYOS_DATABASE_PASSWORD=

# Redis execution transport. The worker password in Infisical must match
# MEMORYOS_REDIS_WORKER_PASSWORD_FILE. No password belongs in this file.
MEMORYOS_REDIS_HOST=redis
MEMORYOS_REDIS_PORT=6379
MEMORYOS_REDIS_USERNAME=memoryos-worker
MEMORYOS_REDIS_SSL_ENABLED=true
MEMORYOS_REDIS_CONNECT_TIMEOUT=2s
MEMORYOS_REDIS_COMMAND_TIMEOUT=2s
MEMORYOS_REDIS_POOL_MAX_ACTIVE=8
MEMORYOS_REDIS_POOL_MAX_IDLE=8
MEMORYOS_REDIS_POOL_MIN_IDLE=0
MEMORYOS_REDIS_POOL_MAX_WAIT=2s
MEMORYOS_SCHEDULER_NAME=memoryos-worker-staging-1
MEMORYOS_REDIS_VOLUME=memoryos-redis-data
MEMORYOS_REDIS_ADMIN_PASSWORD_FILE=/apps/memoryos/secrets/redis/admin-password.txt
MEMORYOS_REDIS_WORKER_PASSWORD_FILE=/apps/memoryos/secrets/redis/worker-password.txt
MEMORYOS_REDIS_INSPECTOR_PASSWORD_FILE=/apps/memoryos/secrets/redis/inspector-password.txt
MEMORYOS_REDIS_TLS_CA_FILE=/apps/memoryos/secrets/redis/ca.crt
MEMORYOS_REDIS_TLS_CERTIFICATE_FILE=/apps/memoryos/secrets/redis/server.crt
MEMORYOS_REDIS_TLS_PRIVATE_KEY_FILE=/apps/memoryos/secrets/redis/server.key


# Shared Keycloak database and runtime
MEMORYOS_KEYCLOAK_DATABASE_NAME=keycloak
MEMORYOS_KEYCLOAK_DATABASE_USERNAME=keycloak
MEMORYOS_KEYCLOAK_DATABASE_PASSWORD=
MEMORYOS_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
MEMORYOS_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
MEMORYOS_KEYCLOAK_HOSTNAME=https://auth.kl3in.tech
MEMORYOS_KEYCLOAK_HOST_PORT=18180
MEMORYOS_KEYCLOAK_LOG_LEVEL=INFO,org.keycloak.events:DEBUG,org.keycloak.services:DEBUG
MEMORYOS_KEYCLOAK_PROVISIONER_CLIENT_SECRET=

# Staging-only captured email
MEMORYOS_MAILPIT_UID=1000
MEMORYOS_MAILPIT_GID=1000
MEMORYOS_MAILPIT_UI_HOST_PORT=18025
MEMORYOS_MAILPIT_PUBLIC_URL=https://memoryos-mail.72-62-193-33.nip.io
MEMORYOS_MAILPIT_DATA_DIRECTORY=/apps/memoryos/mailpit
MEMORYOS_MAILPIT_MAX_MESSAGES=500
MEMORYOS_MAILPIT_MAX_AGE=7d
MEMORYOS_MAILPIT_SMTP_AUTH_FILE=/apps/memoryos/secrets/mailpit/smtp-auth.txt
MEMORYOS_MAILPIT_SMTP_CA_FILE=/apps/memoryos/secrets/mailpit/ca.crt
MEMORYOS_MAILPIT_SMTP_TLS_CERTIFICATE_FILE=/apps/memoryos/secrets/mailpit/smtp.crt
MEMORYOS_MAILPIT_SMTP_TLS_PRIVATE_KEY_FILE=/apps/memoryos/secrets/mailpit/smtp.key
MEMORYOS_MAILPIT_OAUTH2_ALLOWED_EMAILS_FILE=/apps/memoryos/secrets/mailpit/oauth2-allowed-emails.txt
MEMORYOS_MAILPIT_OAUTH2_CLIENT_SECRET_FILE=/apps/memoryos/secrets/mailpit/oauth2-client-secret.txt
MEMORYOS_MAILPIT_OAUTH2_COOKIE_SECRET_FILE=/apps/memoryos/secrets/mailpit/oauth2-cookie-secret.txt

# Staging-only PostgreSQL inspection
MEMORYOS_PGWEB_USERNAME=memoryos_pgweb
MEMORYOS_PGWEB_UID=1000
MEMORYOS_PGWEB_GID=1000
MEMORYOS_PGWEB_QUERY_TIMEOUT_SECONDS=30
MEMORYOS_PGWEB_PUBLIC_URL=https://memoryos-db.72-62-193-33.nip.io
MEMORYOS_PGWEB_PROXY_HOST_PORT=18026
MEMORYOS_PGWEB_DATABASE_PASSWORD_FILE=/apps/memoryos/secrets/inspection/pgweb-database-password.txt
MEMORYOS_PGWEB_OAUTH2_CLIENT_SECRET=
MEMORYOS_PGWEB_OAUTH2_CLIENT_SECRET_FILE=/apps/memoryos/secrets/inspection/pgweb-oauth2-client-secret.txt
MEMORYOS_PGWEB_OAUTH2_COOKIE_SECRET_FILE=/apps/memoryos/secrets/inspection/pgweb-oauth2-cookie-secret.txt
MEMORYOS_PGWEB_CREDENTIALS_VOLUME=memoryos-pgweb-credentials

# Staging-only Redis inspection
MEMORYOS_REDIS_INSPECTOR_PASSWORD=
MEMORYOS_REDISINSIGHT_ENCRYPTION_KEY=
MEMORYOS_REDISINSIGHT_PUBLIC_URL=https://memoryos-redis.72-62-193-33.nip.io
MEMORYOS_REDISINSIGHT_PROXY_HOST_PORT=18027
MEMORYOS_REDISINSIGHT_OAUTH2_CLIENT_SECRET=
MEMORYOS_REDISINSIGHT_OAUTH2_CLIENT_SECRET_FILE=/apps/memoryos/secrets/inspection/redisinsight-oauth2-client-secret.txt
MEMORYOS_REDISINSIGHT_OAUTH2_COOKIE_SECRET_FILE=/apps/memoryos/secrets/inspection/redisinsight-oauth2-cookie-secret.txt
MEMORYOS_REDISINSIGHT_VOLUME=memoryos-redisinsight-data

# Optional only if the memoryos realm has no realm-local admin user.
MEMORYOS_INSPECTOR_ADMIN_EMAIL=
MEMORYOS_INSPECTOR_ADMIN_PASSWORD=

# Mode-0600 Universal Auth bootstrap file outside Git. It contains only the
# Infisical domain/project/environment plus the staging identity client credentials.
MEMORYOS_INFISICAL_BOOTSTRAP_FILE=/apps/memoryos/secrets/api-infisical-auth.staging.env

# Stable networks and loopback diagnostics
MEMORYOS_INTERNAL_NETWORK=memoryos-internal
MEMORYOS_MAILPIT_ACCESS_NETWORK=memoryos-mailpit-access
MEMORYOS_POSTGRES_INSPECTION_NETWORK=memoryos-postgres-inspection
MEMORYOS_PGWEB_ACCESS_NETWORK=memoryos-pgweb-access
MEMORYOS_REDIS_INSPECTION_NETWORK=memoryos-redis-inspection
MEMORYOS_REDISINSIGHT_ACCESS_NETWORK=memoryos-redisinsight-access
MEMORYOS_SHARED_INFRA_NETWORK=shared-infra
MEMORYOS_PROXY_NETWORK=proxy-network
MEMORYOS_PROXY_TRUSTED_CIDR=172.21.0.0/16
MEMORYOS_API_HOST_PORT=18080
MEMORYOS_WEB_HOST_PORT=18081
