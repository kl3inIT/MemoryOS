# Admits only the application node to the ports compose.serving.yaml publishes; see
# serving-firewall.sh. It runs before Docker, and Docker requires it, so at boot no container
# publishes a port before the rule exists, and a firewall that fails keeps Docker down rather than
# exposing an unauthenticated API to the private subnet. Docker keeps the DOCKER-USER rules it finds.
# Deployments reapply the rule by running the script, never by restarting this unit: Docker
# requires it, so restarting it would restart Docker and every container with it.
# The allowed address and ports come from the serving node's environment file, the same one Compose
# reads. See docs/runbooks/ci-cd.md#serving-node.
[Unit]
Description=Restrict MemoryOS serving ports to the application node
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/apps/memoryos-serving/.env.serving
ExecStart=/bin/sh -c 'exec /usr/local/sbin/memoryos-serving-firewall "$MEMORYOS_SERVING_ALLOWED_SOURCE" $MEMORYOS_SERVING_PORTS'

[Install]
RequiredBy=docker.service
