# The serving node's environment: /apps/memoryos-serving/.env.serving, mode 0600, owned by root.
# Compose reads it for compose.serving.yaml and memoryos-serving-firewall.service reads it for the
# firewall. It holds no secret: the embedding key is its own file,
# /apps/memoryos-serving/secrets/tei/api-key.txt, and OCR authenticates no caller, the network does.
# Everything else defaults in compose.serving.yaml. See docs/runbooks/ci-cd.md#serving-node.

# The private address the layout API and the embedding service are published on.
# Never 0.0.0.0 and never a public address.
MEMORYOS_SERVING_PRIVATE_ADDRESS=172.24.244.79

# The only source admitted to the published ports, and those ports, space separated. The worker on
# the application node calls http://<private address>:<PaddleOCR-VL port> for OCR; the api and the
# worker call http://<private address>:<TEI port>/v1 for embeddings, with the key. Every published
# port must be listed, or deploy-serving.sh refuses the rollout.
MEMORYOS_SERVING_ALLOWED_SOURCE=172.24.244.120
MEMORYOS_PADDLEOCR_VL_PORT=18080
MEMORYOS_TEI_PORT=18090
MEMORYOS_SERVING_PORTS=18080 18090
