# Values Compose cannot default: release images, passwords, public origins, the Tenant
# identity and secret-file locations. Every other setting (networks, volumes, loopback
# ports, UIDs, Redis pool, Docling limits) has its default in compose.base.yaml or
# compose.production.yaml; add it here only to override that default.
#
# Production runs no inspection tooling and no mail server, so this file has no Mailpit,
# pgweb, RedisInsight, MinIO Console or SMTP section. Those surfaces are deferred until the
# product owner asks for them; reach the runtime through an SSH tunnel until then.

# Release images; the remaining pinned images default in Compose.
MEMORYOS_API_IMAGE=
MEMORYOS_WORKER_IMAGE=
MEMORYOS_WEB_IMAGE=
MEMORYOS_INTERPRETER_IMAGE=
MEMORYOS_INTERPRETER_EXECUTOR_IMAGE=
# No MEMORYOS_KEYCLOAK_IMAGE: each release brings memoryos-keycloak, with the login theme inside
# it, and the deployment rolls it out. Naming an image here takes Keycloak out of the release.

# PostgreSQL memory. The Compose defaults are deliberately modest because staging shares its host
# with unrelated services; this node has 31 GiB and gives PostgreSQL roughly 8 GiB of it, the rest
# going to OpenSearch, the api, the worker, Keycloak, the observability stack and extraction.
# work_mem is charged per sort or hash inside a query, not per connection, so the worst case is
# roughly the pool size times the operations one query can hold at once.
MEMORYOS_POSTGRES_SHARED_BUFFERS=2GB
MEMORYOS_POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
MEMORYOS_POSTGRES_WORK_MEM=16MB
MEMORYOS_POSTGRES_MAINTENANCE_WORK_MEM=512MB

# PostgreSQL platform administrator and MemoryOS application role passwords
MEMORYOS_POSTGRES_ADMIN_PASSWORD=
MEMORYOS_DATABASE_PASSWORD=

# Docling: Worker extraction options and private service limits default in compose.base.yaml.
# Keep the Worker timeout within the service document maximum; see docs/specs/ingestion.md
# and docs/runbooks/docling-extraction.md before overriding. MEMORYOS_EXTRACTION_DOCLING_API_KEY
# is a file generated on this server; never put its value here.

# PaddleOCR-VL layout API on the serving node (MEM-192). Once set, scans and images go there and
# Docling stops doing OCR; unset (the compose.base.yaml default) keeps Docling's OCR. There is no
# key: the service accepts only this node's address (docs/runbooks/docling-extraction.md). The port
# is the one compose.serving.yaml publishes (MEMORYOS_PADDLEOCR_VL_PORT, 18080 by default):
# MEMORYOS_EXTRACTION_PADDLEOCR_VL_ENDPOINT=http://172.24.244.79:18080
# Each worker sends at most MEMORYOS_EXTRACTION_PADDLEOCR_VL_MAX_CONCURRENT_REQUESTS (default 2,
# 1-16) documents at once and queues the rest; MEMORYOS_EXTRACTION_PADDLEOCR_VL_TIMEOUT (default
# 30m) counts from when a document is sent. Staging reads through the same GPU.

# Private object storage. Deployment-owned secret files are mounted into bootstrap
# and the matching API or worker runtime; no secret value belongs in this file.
# The three MinIO key files default to /apps/memoryos/secrets/minio/{root-password,
# api-secret-key,worker-secret-key}.txt in compose.base.yaml; override only to move them.
MEMORYOS_OBJECT_STORAGE_UPLOAD_ENDPOINT=https://objects.vadan.app
MEMORYOS_OBJECT_STORAGE_BROWSER_ORIGIN=https://app.vadan.app
MEMORYOS_OBJECT_STORAGE_CONNECT_SRC=https://objects.vadan.app

# Stable Tenant bootstrap contract
MEMORYOS_TENANT_ID=
MEMORYOS_TENANT_SLUG=
MEMORYOS_TENANT_DISPLAY_NAME=
MEMORYOS_INITIAL_TENANT_CHANGE_REFERENCE=

# TLS Redis. The worker's and API's host, port, ACL user and TLS mode are fixed in
# compose.production.yaml; they read MEMORYOS_REDIS_WORKER_PASSWORD_FILE and
# MEMORYOS_REDIS_API_PASSWORD_FILE as their credentials. No password belongs here.
# There is no inspector password because production runs no Redis inspector.
MEMORYOS_REDIS_ADMIN_PASSWORD_FILE=/apps/memoryos/secrets/redis/admin-password.txt
MEMORYOS_REDIS_WORKER_PASSWORD_FILE=/apps/memoryos/secrets/redis/worker-password.txt
MEMORYOS_REDIS_API_PASSWORD_FILE=/apps/memoryos/secrets/redis/api-password.txt
MEMORYOS_REDIS_TLS_CA_FILE=/apps/memoryos/secrets/redis/ca.crt
MEMORYOS_REDIS_TLS_CERTIFICATE_FILE=/apps/memoryos/secrets/redis/server.crt
MEMORYOS_REDIS_TLS_PRIVATE_KEY_FILE=/apps/memoryos/secrets/redis/server.key

# Keycloak. Production runs its own realm on its own host and shares nothing with staging
# or OrgMemory; the hostname must be set here, because the Compose default points at staging.
# The realm is deliberately unable to send mail: it has no SMTP server and no e-mail
# verification, and members are admitted through JIT (MEM-172), not invitation e-mail.
MEMORYOS_KEYCLOAK_DATABASE_PASSWORD=
MEMORYOS_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
MEMORYOS_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
MEMORYOS_KEYCLOAK_HOSTNAME=https://auth.vadan.app
MEMORYOS_KEYCLOAK_PROVISIONER_CLIENT_SECRET=

# Secrets are files generated on this server; their paths default in compose.base.yaml under
# /apps/memoryos/secrets/. Override one only to move it.

# Observability. The api and worker join the `memoryos-telemetry` network and send traces, logs
# and metrics to that stack's collector. The network is declared external, so the observability
# stack must already be running before any deployment: Compose refuses to start otherwise, and
# the message names a missing network rather than a missing stack. Start it with
# infrastructure/observability/compose.observability.yaml first; see docs/runbooks/ci-cd.md.
# Both the collector address and the network name default in compose.production.yaml.

# The deployed source revision. CD writes it from the release bundle.
MEMORYOS_RELEASE=

# Browser-visible Sentry Cloud endpoint. This is not a credential; do not set a Sentry
# source-map upload token on the production host. The environment name defaults to
# production in compose.production.yaml.
MEMORYOS_SENTRY_DSN=
# Exact DSN origin only, for example https://o123.ingest.us.sentry.io.
MEMORYOS_SENTRY_CONNECT_SRC=

# Search. The service password is a file on this server; the endpoint and the service user
# default to the composition's own names. There is no Dashboards origin because production
# publishes no Dashboards. One node holds every shard, so a replica would never be assigned
# and the cluster would never reach green; see compose.search.production.yaml.
MEMORYOS_OPENSEARCH_SECRET_DIRECTORY=/apps/memoryos/secrets/opensearch
MEMORYOS_SEARCH_REPLICAS=0

# Identity. The realm lives on this deployment's own Keycloak; the audience is the API client
# the browser asks tokens for. MEMORYOS_INITIAL_OWNER_SUBJECT is the Keycloak subject of the
# first owner, which is who the Tenant is handed to on the first start.
MEMORYOS_IDENTITY_ISSUER=https://auth.vadan.app/realms/memoryos
MEMORYOS_IDENTITY_JWK_SET_URI=https://auth.vadan.app/realms/memoryos/protocol/openid-connect/certs
MEMORYOS_IDENTITY_AUDIENCE=memoryos-api
# The Keycloak subject (sub) of the first owner. Replace with the real one before the
# first start; this placeholder only keeps the composition renderable in review.
MEMORYOS_INITIAL_OWNER_SUBJECT=00000000-0000-0000-0000-000000000000
MEMORYOS_SESSION_COOKIE_SECURE=true
# Members are admitted by JIT from the listed Keycloak identity provider aliases (MEM-172).
# An empty list admits nobody.
MEMORYOS_JIT_ALLOWED_PROVIDER_ALIASES=

# Browser return addresses. Each must also be registered on the matching client or provider.
MEMORYOS_INVITATION_ACTIVATION_REDIRECT_URI=https://app.vadan.app/invite/activate
MEMORYOS_GOOGLE_DRIVE_REDIRECT_URI=https://app.vadan.app/login/oauth2/code/google-drive
MEMORYOS_MCP_REDIRECT_URI=https://app.vadan.app/login/oauth2/code/mcp

# Names the stored Google Drive credentials are sealed under. Production generates its own
# encryption key, so this version must not be copied from another environment.
MEMORYOS_GOOGLE_DRIVE_CREDENTIAL_KEY_VERSION=production-v1
