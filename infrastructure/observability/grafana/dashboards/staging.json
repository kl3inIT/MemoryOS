{
  "uid": "memoryos-staging",
  "title": "MemoryOS staging",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "memoryos",
    "staging"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, status) (rate(http_server_requests_milliseconds_count[5m]))",
          "legendFormat": "{{service_name}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_requests_milliseconds_bucket[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "JVM memory",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, area) (jvm_memory_used_bytes)",
          "legendFormat": "{{service_name}} {{area}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "JVM GC time / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(jvm_gc_pause_milliseconds_sum[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "JDBC active / pending",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active or hikaricp_connections_pending",
          "legendFormat": "{{__name__}} {{service_name}} {{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Redis depth / pending",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "memoryos_redis_stream_depth or memoryos_redis_stream_pending",
          "legendFormat": "{{__name__}} {{service_name}} {{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Redis deliveries",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workload, outcome) (rate(memoryos_redis_delivery_total[5m]))",
          "legendFormat": "{{workload}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Worker p95 processing",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, workload) (rate(memoryos_redis_operation_processing_milliseconds_bucket[5m])))",
          "legendFormat": "{{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Ingestion and cleanup events",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-loki",
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (count_over_time({service_name=\"memoryos-worker\"} | event=~\"ingestion.*|cleanup.*\" [5m]))",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Application errors",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-loki",
        "type": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"memoryos-api|memoryos-worker\"} | severity_text=~\"WARN|ERROR\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Alert state",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Process CPU usage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Processing outcomes / second",
      "description": "Coordinator invocations, independent of Redis ACK. FAILED includes handled retries; UNHANDLED escaped the coordinator; SKIPPED includes duplicate/stale deliveries. Not unique operations.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workload, outcome) (rate(memoryos_operation_outcomes_total[5m]))",
          "legendFormat": "{{workload}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Initial queue wait p95",
      "description": "PostgreSQL creation to first claim only. Includes initial dispatch/worker downtime; excludes retry and reclaim waits. No traffic means no data. Histogram resolution tops out at one hour; not an accepted SLO.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "memoryos-prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, workload) (rate(memoryos_operation_initial_queue_wait_milliseconds_bucket[5m])))",
          "legendFormat": "{{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
